  classDef server fill:#E8F7F2,stroke:#16836B,color:#145647,stroke-width:1.5px;
  class CI control;
  class TEST,RECORD client;
  class WORKER,POLICY,STATE,ROUTER,ACTIVE,CANDIDATE,PREVIOUS server;
