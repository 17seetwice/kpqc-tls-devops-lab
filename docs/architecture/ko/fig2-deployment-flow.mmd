flowchart TB
 BUILD["이미지 빌드 및 시험"] --> AUTH["AWS 권한 취득 / OIDC"]
 AUTH --> DEPLOY["후보 배포 / SSH"]
 DEPLOY --> TEST["TLS 프로브 및 증적 검증"]
 TEST --> GATE{"정책 충족"}
 GATE -->|"통과"| PROMOTE["후보 승격"]
 GATE -->|"거절"| KEEP["후보 거절 / 기존 서비스 유지"]
 PROMOTE --> VERIFY["전환 확인"]
 VERIFY --> END["증적 저장 및 자원 정리"]
 KEEP --> END
