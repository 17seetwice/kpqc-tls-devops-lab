flowchart TB
 BUILD["Build and test image"] --> AUTH["Obtain AWS credentials / OIDC"]
 AUTH --> DEPLOY["Deploy candidate / SSH"]
 DEPLOY --> TEST["TLS probes and evidence validation"]
 TEST --> GATE{"Policy satisfied"}
 GATE -->|"Pass"| PROMOTE["Promote candidate"]
 GATE -->|"Reject"| KEEP["Reject / retain active"]
 PROMOTE --> VERIFY["Verify promotion"]
 VERIFY --> END["Collect evidence and clean up"]
 KEEP --> END
